# .env.example – fill in the values before running the app

# Privy App ID (required)
VITE_PRIVY_APP_ID=your-privy-app-id

# WalletConnect Project ID (required)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Anthropic API Key (Claude AI)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Biconomy Paymaster & Bundler URLs
VITE_BICONOMY_PAYMASTER_URL=your-biconomy-paymaster-url
VITE_BICONOMY_BUNDLER_URL=your-biconomy-bundler-url

# LayerZero App ID
VITE_LAYERZERO_APP_ID=your-layerzero-app-id

# Twitter Bearer Token (X API)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Apify token (fallback for X)
APIFY_TOKEN=your-apify-token

# Discord Bot Token
DISCORD_BOT_TOKEN=your-discord-bot-token

# Dune API Key
DUNE_API_KEY=your-dune-api-key

# The Graph API Key
GRAPH_API_KEY=your-graph-api-key

# Nansen API Key
NANSEN_API_KEY=your-nansen-api-key

# Mobula API Key
MOBULA_API_KEY=your-mobula-api-key

# Messari API Key
MESSARI_API_KEY=your-messari-api-key

# Auto-configured (no changes needed)
VITE_MANTLE_RPC=https://rpc.mantle.xyz
VITE_MANTLE_CHAIN_ID=5000
VITE_MANTLE_EXPLORER=https://explorer.mantle.xyz
REDIS_URL=redis://localhost:6379

# LI.FI Configuration
VITE_LIFI_INTEGRATOR=mantle-agentic-portal
VITE_LIFI_API=https://li.quest/v1
VITE_LIFI_INTENTS_API=https://order.li.fi
VITE_LIFI_EARN_API=https://earn.li.fi
LIFI_API_KEY=your-lifi-api-key

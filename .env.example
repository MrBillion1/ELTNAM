# Mantle Agentic Portal environment variables
# Copy this file to .env and fill in the values you have ready.

# ASK ME FOR THESE (cannot be auto-fetched)
VITE_PRIVY_APP_ID=                    # dashboard.privy.io -> Create App -> App ID
VITE_WALLETCONNECT_PROJECT_ID=        # cloud.walletconnect.com -> New Project
ANTHROPIC_API_KEY=                    # console.anthropic.com -> API Keys
VITE_BICONOMY_PAYMASTER_URL=          # dashboard.biconomy.io -> Paymaster -> URL
VITE_BICONOMY_BUNDLER_URL=            # dashboard.biconomy.io -> Bundler -> URL
VITE_LAYERZERO_APP_ID=                # layerzeroscan.com -> Developer
TWITTER_BEARER_TOKEN=                 # developer.twitter.com -> Project -> Bearer Token
APIFY_TOKEN=                          # console.apify.com -> Settings -> API
DISCORD_BOT_TOKEN=                    # discord.com/developers -> New App -> Bot Token
DUNE_API_KEY=                         # dune.com -> Settings -> API Key
GRAPH_API_KEY=                        # thegraph.com/studio -> API Keys
NANSEN_API_KEY=                       # nansen.ai -> API (100 free credits)
MOBULA_API_KEY=                       # app.mobula.io -> Developer
MESSARI_API_KEY=                      # messari.io -> Account -> API

# AUTO-CONFIGURED (no action needed)
VITE_MANTLE_RPC=https://rpc.mantle.xyz
VITE_MANTLE_CHAIN_ID=5000
VITE_MANTLE_EXPLORER=https://explorer.mantle.xyz
REDIS_URL=redis://localhost:6379

# LI.FI Configuration
VITE_LIFI_INTEGRATOR=mantle-agentic-portal
VITE_LIFI_API=https://li.quest/v1
VITE_LIFI_INTENTS_API=https://order.li.fi
VITE_LIFI_EARN_API=https://earn.li.fi
LIFI_API_KEY=

